# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[go.{mod,sum}]
indent_style = tab

# Windows PowerShell 5.1 reads BOM-less scripts as the system code page,
# so keep .ps1 files ASCII-only.
[*.ps1]
indent_size = 4

[*.md]
# Markdown uses two trailing spaces as a hard line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
