# Vite proxies these paths to the local Go backend (go run ./cmd/all2api).
VITE_PROXY_TARGET=http://127.0.0.1:8888

# Public browser-side API base path. Do not put credentials or secrets here.
VITE_ADMIN_API_BASE_URL=/admin/api

# Optional public gateway base URL shown on the Gateway Keys page.
# Leave empty to use the current browser origin plus /v1.
VITE_GATEWAY_BASE_URL=
