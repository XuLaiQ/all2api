# E2E Test Configuration Example
#
# Copy this file to .env.e2e and fill in real credentials for E2E testing.
# NEVER commit .env.e2e to Git!

# Enable E2E tests
E2E_ENABLED=true
E2E_USE_SOURCE_ACCOUNTS=false

# ChatGPT E2E Tests
E2E_CHATGPT_ENABLED=true
CHATGPT_TEST_EMAIL=test@example.com
CHATGPT_TEST_ACCESS_TOKEN=eyJhbGci...
CHATGPT_TEST_REFRESH_TOKEN=rt.1.AAA...
CHATGPT_TEST_USER_ID=user-xxx
CHATGPT_TEST_ORG_ID=org-xxx
CHATGPT_TEST_EXPORT_FILE=E:/path/to/sub2api-export.json
CHATGPT_TEST_ACCOUNT_INDEX=0

# WorkBuddy E2E Tests
E2E_WORKBUDDY_ENABLED=true
WB_TEST_ACCESS_TOKEN=xxx
WB_TEST_REFRESH_TOKEN=xxx
WB_TEST_REALM=cn
WB_TEST_UID=xxx
WB_TEST_AUTH_DIR=F:/token-p/WorkBuddy/wb2api/data/auths
WB_TEST_AUTH_FILE=
WB_TEST_DOMAIN=
WB_TEST_ENTERPRISE_ID=
WB_TEST_DEVICE_TOKEN=

# Doubao E2E Tests
E2E_DOUBAO_ENABLED=true
DOUBAO_TEST_ACCOUNT_ID=test_account_001
DOUBAO_TEST_PROFILE_ROOT=F:/token-p/反代/doubao2api/data/accounts

# Test Configuration
E2E_TIMEOUT=300
E2E_RETRY_COUNT=3
