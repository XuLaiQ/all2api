# ============================================================================
# 网关后端环境变量模板（M1 起生效）
# 复制为 .env 后按需修改；.env 不入库。
# 变量语义与 docs/系统设计与实现文档.md §11.2 的 config.yaml 一一对应。
# 全项目配置说明见 docs/项目开发基线.md 的“环境配置”。
# ============================================================================

# ---------- 服务 ----------
A2A_HOST=0.0.0.0
A2A_PORT=8080
A2A_BASE_PATH=

# ---------- 存储 ----------
A2A_DB_PATH=./data/all2api.db
A2A_STATE_PATH=./data/gateway/state.json

# ---------- 安全 ----------
# 生产必须替换为随机 64 字节，禁止使用默认值
A2A_SESSION_SECRET=dev-only-change-me
A2A_ADMIN_USERNAME=admin
A2A_ADMIN_PASSWORD=
A2A_ALLOW_WEAK_ADMIN_PASSWORD=false
A2A_ADMIN_TOKEN=
A2A_BOOTSTRAP_API_KEY=
A2A_BOOTSTRAP_RPM=60
A2A_SESSION_DAYS=1
A2A_SESSION_IDLE_HOURS=12
A2A_SECURE_COOKIE=auto
A2A_TRUST_PROXY=true
A2A_TRUSTED_PROXIES=127.0.0.1,::1
A2A_LOGIN_MAX_FAILS=5
A2A_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 日志保留 ----------
A2A_LOG_RETENTION_DAYS=30
A2A_USAGE_RETENTION_DAYS=365

# ---------- 上游渠道凭据 ----------
# 网关通过各上游的 HTTP 接口访问，不直接读账号凭据文件。
# 账号凭据（token / OAuth / 浏览器 profile）留在各上游后端本地。
A2A_WB_UPSTREAM_BASE=http://127.0.0.1:7864
A2A_WB_ADMIN_TOKEN=
A2A_WB_DATA_KEY=
A2A_WB_TRACE_SECRET=

A2A_DOUBAO_UPSTREAM_BASE=http://127.0.0.1:9090
A2A_DOUBAO_API_KEY=
A2A_DOUBAO_PUBLIC_DATA_PLANE=false

A2A_CHATGPT_UPSTREAM_BASE=http://127.0.0.1:8000
A2A_CHATGPT_AUTH_KEY=
