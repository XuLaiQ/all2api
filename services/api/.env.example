# ============================================================================
# 网关后端环境变量模板（M1 起生效）
# 复制为 .env 后按需修改；.env 不入库。
# 变量语义与 docs/系统设计与实现文档.md §11.2 的 config.yaml 一一对应。
# 全项目配置说明见 docs/项目开发基线.md 的“环境配置”。
# ============================================================================

# ---------- 服务 ----------
A2A_HOST=0.0.0.0
A2A_PORT=8888
A2A_BASE_PATH=

# ---------- 存储 ----------
A2A_DB_PATH=./data/all2api.db
A2A_PROVISION_SESSION_TTL_SECONDS=600
A2A_STATE_PATH=./data/gateway/state.json
# Production: inject a random Fernet key (or high-entropy secret) through a
# secret manager. It is never returned by the API or written to the database.
A2A_CREDENTIAL_MASTER_KEY=

# ---------- 安全 ----------
# 生产必须替换为随机 64 字节，禁止使用默认值
A2A_SESSION_SECRET=dev-only-change-me
A2A_ENV=development
A2A_ADMIN_USERNAME=admin
A2A_ADMIN_PASSWORD=
A2A_ALLOW_WEAK_ADMIN_PASSWORD=false
A2A_ADMIN_TOKEN=
A2A_BOOTSTRAP_API_KEY=
A2A_BOOTSTRAP_RPM=60
A2A_SESSION_DAYS=1
A2A_SESSION_IDLE_HOURS=12
A2A_SECURE_COOKIE=auto
A2A_TRUST_PROXY=true
A2A_TRUSTED_PROXIES=127.0.0.1,::1
A2A_LOGIN_MAX_FAILS=5
A2A_CORS_ORIGINS=http://localhost:5555,http://127.0.0.1:5555

# ---------- 日志保留 ----------
A2A_LOG_RETENTION_DAYS=30
A2A_USAGE_RETENTION_DAYS=365

# ---------- 内置渠道平台（native adapter） ----------
# 这些地址由本项目 adapter/client/worker 使用，不能填写旧项目管理端口。
A2A_WB_PLATFORM_BASE=https://copilot.tencent.com
A2A_DOUBAO_PLATFORM_BASE=https://www.doubao.com
A2A_CHATGPT_PLATFORM_BASE=https://auth.openai.com
A2A_CHATGPT_PROXY=

# ---------- 迁移期 legacy bridge（默认关闭，目标态将移除） ----------
# 仅在需要与旧项目行为对照时显式开启。native provisioner 不读取这些变量。
A2A_LEGACY_BRIDGE_ENABLED=false
A2A_LEGACY_WB_UPSTREAM_BASE=
A2A_LEGACY_WB_ADMIN_TOKEN=
A2A_LEGACY_WB_DATA_KEY=
A2A_LEGACY_DOUBAO_UPSTREAM_BASE=
A2A_LEGACY_DOUBAO_API_KEY=
A2A_LEGACY_CHATGPT_UPSTREAM_BASE=
A2A_LEGACY_CHATGPT_AUTH_KEY=

# Deprecated aliases kept only for existing migration deployments. Prefer the
# explicit A2A_LEGACY_* names above, and never put OAuth/Cookie/profile data here.
A2A_WB_UPSTREAM_BASE=
A2A_WB_ADMIN_TOKEN=
A2A_WB_DATA_KEY=
A2A_WB_TRACE_SECRET=
A2A_DOUBAO_UPSTREAM_BASE=
A2A_DOUBAO_API_KEY=
A2A_DOUBAO_PROFILE_ROOT=./data/doubao/profiles
# Optional native Go CDP worker. Keep disabled unless Chromium and the
# separately protected worker endpoint are available.
A2A_DOUBAO_BROWSER_ENABLED=false
A2A_DOUBAO_BROWSER_EXECUTABLE=
A2A_DOUBAO_BROWSER_WORKER_BASE=http://127.0.0.1:8891
A2A_DOUBAO_BROWSER_WORKER_TOKEN=
A2A_DOUBAO_BROWSER_HEADLESS=true
A2A_DOUBAO_BROWSER_LOGIN_PATH=/
A2A_DOUBAO_BROWSER_MAX_CONTEXTS=4
A2A_DOUBAO_BROWSER_MAX_PAGES_PER_CONTEXT=2
A2A_DOUBAO_BROWSER_OPERATION_TIMEOUT_SECONDS=30
A2A_DOUBAO_BROWSER_LAUNCH_TIMEOUT_SECONDS=30
A2A_DOUBAO_BROWSER_SESSION_TTL_SECONDS=300
A2A_DOUBAO_BROWSER_QR_SELECTOR=img[src*="qr"], canvas[data-qr]
A2A_DOUBAO_BROWSER_QR_CODE_ATTRIBUTE=data-code
A2A_DOUBAO_BROWSER_AUTHENTICATED_SELECTOR=[data-testid="user-avatar"], [data-authenticated="true"]
A2A_MEDIA_WORKER_TOKEN=
A2A_CHATGPT_UPSTREAM_BASE=
A2A_CHATGPT_AUTH_KEY=
