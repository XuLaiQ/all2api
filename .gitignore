# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.*.example
.mimosa

# Dependencies and package-manager caches
**/node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml

# Frontend and JavaScript build output
**/dist/
**/build/
**/.vite/
**/.cache/
*.tsbuildinfo
coverage/
.nyc_output/
.eslintcache

# Python environments, caches, and build output
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Runtime data generated by the API
services/api/data/
*.db-wal
*.db-shm

# Logs, temporary files, and local tooling state
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.workbuddy-ai/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

tests
# Keep only focused tests added by the current migration work visible. The
# broad rule above still hides unrelated generated or legacy test directories.
!services/api/
!services/api/tests/
services/api/tests/*
!services/api/tests/e2e/
!services/api/tests/e2e/*.py
!services/api/tests/test_account_lifecycle_routing.py
!services/api/tests/test_admin_settings.py
!services/api/tests/test_healthz.py
!services/api/tests/test_provision_state.py
