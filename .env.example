# All2API configuration template. Copy to .env and fill in the secrets.
# The Go binary reads ./.env at startup (or the file named by A2A_ENV_FILE);
# variables already set in the process environment always take precedence.
# docker compose reads the same file for ${VAR} substitution.

# --- Ports used by docker-compose.yml ---------------------------------------
WEB_PORT=5555
API_PORT=8888
# Vite dev-server proxy target when running the console outside Docker.
VITE_PROXY_TARGET=http://127.0.0.1:8888

# --- Service ----------------------------------------------------------------
# development | test | staging | production. production enforces strong
# secrets and refuses removed legacy-bridge variables.
A2A_ENV=development
A2A_HOST=127.0.0.1
A2A_PORT=8888
A2A_DB_PATH=./data/all2api.db
A2A_STATE_PATH=./data/gateway/state.json

# --- Secrets (inject from a secret manager in production) -------------------
# Random value, at least 32 characters in production.
A2A_SESSION_SECRET=dev-only-change-me
# Fernet key or high-entropy secret (>= 32 chars in production). Encrypts all
# stored account credentials: back it up together with the database.
A2A_CREDENTIAL_MASTER_KEY=
A2A_ADMIN_USERNAME=admin
# At least 12 characters. Login is disabled while this is empty.
A2A_ADMIN_PASSWORD=
A2A_ALLOW_WEAK_ADMIN_PASSWORD=false
# Optional wbt_* token for automation (Authorization: Bearer ...).
A2A_ADMIN_TOKEN=
# Optional sk-a2a-* key (>= 40 chars) kept in sync at startup; clear to disable.
A2A_BOOTSTRAP_API_KEY=
A2A_BOOTSTRAP_RPM=60

# --- Sessions, proxies and browser origins ----------------------------------
A2A_SESSION_DAYS=1
A2A_SESSION_IDLE_HOURS=12
A2A_LOGIN_MAX_FAILS=5
# auto | true | false
A2A_SECURE_COOKIE=auto
A2A_TRUST_PROXY=true
A2A_TRUSTED_PROXIES=127.0.0.1,::1
A2A_CORS_ORIGINS=http://localhost:5555,http://127.0.0.1:5555

# --- Retention ---------------------------------------------------------------
A2A_LOG_RETENTION_DAYS=30
# Must be >= A2A_LOG_RETENTION_DAYS.
A2A_USAGE_RETENTION_DAYS=365
A2A_PROVISION_SESSION_TTL_SECONDS=600

# --- Channel platform endpoints ---------------------------------------------
A2A_WB_PLATFORM_BASE=https://copilot.tencent.com
A2A_DOUBAO_PLATFORM_BASE=https://www.doubao.com
A2A_CHATGPT_PLATFORM_BASE=https://auth.openai.com
A2A_CHATGPT_WEB_BASE=https://chatgpt.com
# Optional outbound proxy for ChatGPT, e.g. http://127.0.0.1:7890
A2A_CHATGPT_PROXY=
A2A_GROK_PLATFORM_BASE=https://grok.com
A2A_GROK_BUILD_BASE=https://cli-chat-proxy.grok.com/v1
# Optional outbound proxy for grok.com / auth.x.ai (needed where xAI is blocked)
A2A_GROK_PROXY=

# --- Doubao browser worker (optional; QR login over HTTP is the default) ----
A2A_DOUBAO_PROFILE_ROOT=./data/doubao/profiles
A2A_DOUBAO_BROWSER_ENABLED=false
A2A_DOUBAO_BROWSER_WORKER_BASE=http://127.0.0.1:8891
# Required when the browser worker is enabled.
A2A_DOUBAO_BROWSER_WORKER_TOKEN=
A2A_DOUBAO_BROWSER_HEADLESS=true
A2A_DOUBAO_BROWSER_EXECUTABLE=

# --- Media worker -------------------------------------------------------------
A2A_MEDIA_WORKER_TOKEN=
