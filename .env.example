A2A_TRUSTED_PROXIES=127.0.0.1,::1
A2A_WB_UPSTREAM_BASE=http://host.docker.internal:7864
A2A_WB_ADMIN_TOKEN=
A2A_WB_DATA_KEY=
A2A_WB_TRACE_SECRET=
A2A_DOUBAO_UPSTREAM_BASE=http://host.docker.internal:9090
A2A_DOUBAO_API_KEY=
A2A_DOUBAO_PUBLIC_DATA_PLANE=false
