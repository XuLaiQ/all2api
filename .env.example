# Settings used by the root docker-compose.yml for local development.
WEB_PORT=5555
API_PORT=8888
VITE_PROXY_TARGET=http://api:8888
A2A_SESSION_SECRET=dev-only-change-me
A2A_ENV=development
# Fernet key (or high-entropy secret) used by the local encrypted credential store.
A2A_CREDENTIAL_MASTER_KEY=
A2A_ADMIN_USERNAME=admin
A2A_ADMIN_PASSWORD=
A2A_ALLOW_WEAK_ADMIN_PASSWORD=false
A2A_ADMIN_TOKEN=
A2A_BOOTSTRAP_API_KEY=
A2A_BOOTSTRAP_RPM=60
A2A_LOG_RETENTION_DAYS=30
A2A_USAGE_RETENTION_DAYS=365
A2A_PROVISION_SESSION_TTL_SECONDS=600
A2A_TRUST_PROXY=true
A2A_TRUSTED_PROXIES=127.0.0.1,::1
# 迁移期 legacy bridge（默认关闭）。保持 upstream 为空，避免 clean
# 部署意外连接旧项目；仅在一次性迁移联调时通过未入库的 .env 显式设置。
A2A_WB_UPSTREAM_BASE=
A2A_WB_ADMIN_TOKEN=
A2A_WB_DATA_KEY=
A2A_WB_TRACE_SECRET=

# 以下同样仅供迁移期 bridge；目标态由内置渠道 adapter 管理凭据和平台客户端。
A2A_DOUBAO_UPSTREAM_BASE=
A2A_DOUBAO_API_KEY=
# 本项目自有的 Doubao 浏览器 profile 根目录；禁止指向旧项目 data 目录。
A2A_DOUBAO_PROFILE_ROOT=./data/doubao/profiles
A2A_DOUBAO_BROWSER_ENABLED=false
A2A_DOUBAO_BROWSER_WORKER_BASE=http://127.0.0.1:8891
A2A_DOUBAO_BROWSER_WORKER_TOKEN=
A2A_MEDIA_WORKER_TOKEN=
A2A_CHATGPT_UPSTREAM_BASE=
A2A_CHATGPT_AUTH_KEY=
A2A_CHATGPT_PROXY=
